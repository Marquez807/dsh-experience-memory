{
  "note": "人工标注的投递场景集：每条给一次真实形状的工具调用，写明这一次**应该**被端出来的是哪条记录（按 id）。用于衡量判据的召回（该送的送没送到）；误报用同一批工具跑 tools/calls.jsonl 里 15383 次真实调用来量。判据只输出一条记录，所以召回判据是「送出的那条 == expect」。",
  "cases": [
    {
      "id": "git-no-exe",
      "why": "要看提交与推送状态，按经验别起 git.exe，直接读 .git 文件",
      "tool": "pwsh",
      "arguments": { "command": "git log --oneline -5; git status --porcelain", "description": "查看本地提交与远端状态" },
      "expect": "a2daa5dc426961c4e412"
    },
    {
      "id": "git-no-exe-2",
      "why": "同一个坑的另一种写法：直接问远端分支",
      "tool": "pwsh",
      "arguments": { "command": "git fetch origin && git rev-parse origin/main" },
      "expect": "a2daa5dc426961c4e412"
    },
    {
      "id": "bom-write",
      "why": "用 PowerShell 写 JSON，正是 BOM 硬规矩管的动作",
      "tool": "pwsh",
      "arguments": { "command": "Set-Content -Path .bigfat\\facts.jsonl -Value $json" },
      "expect": "512e622341cb5fd4c3f3"
    },
    {
      "id": "bom-guard",
      "why": "写文件的后半步：跑 BOM 守卫脚本",
      "tool": "pwsh",
      "arguments": { "command": "powershell -ExecutionPolicy Bypass -File dsh-bom-guard.ps1" },
      "expect": "512e622341cb5fd4c3f3"
    },
    {
      "id": "desktop-storage",
      "why": "正在改 desktop-storage.json，页面还开着",
