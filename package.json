{
  "name": "dsh-experience-memory",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Domain-scoped long-term experience memory for DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "memory",
    "long-term-memory",
    "experience-memory"
  ],
  "author": "Marquez807",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marquez807/dsh-experience-memory.git"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "prepare": "node tools/build.mjs",
    "prepack": "node tools/build.mjs",
    "test": "node --experimental-strip-types tests/run.ts",
    "test:built": "node tools/build.mjs --check && node tests/built.mjs",
    "verify": "node --experimental-strip-types tests/run.ts && node tools/build.mjs --check && node tests/built.mjs"
  }
}
